{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/kite/live.js": { "maxDuration": 300 },
    "api/kite/instruments.js": { "maxDuration": 30 },
    "api/kite/history.js": { "maxDuration": 30 },
    "api/kite/orders.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
